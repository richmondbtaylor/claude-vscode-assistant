            }
          ]
        },
        "options": {}
      },
      "id": "slack-confirm-skipped",
      "name": "Update Slack — Skipped",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": ""
      },
      "id": "respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 520]
    }
  ],
  "connections": {
