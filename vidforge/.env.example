# Where models, outputs and the job database live. Defaults to ~/.vidforge
VIDFORGE_HOME=

# Bind address for the web UI / API
VIDFORGE_HOST=127.0.0.1
VIDFORGE_PORT=8787

# torch device for the diffusers backend: cuda | mps | cpu | auto
VIDFORGE_DEVICE=auto

# Base URL of a running ComfyUI instance, for the comfyui backend
VIDFORGE_COMFY_URL=http://127.0.0.1:8188
